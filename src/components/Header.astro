---
import Logo from "./Logo.astro";
import { phones } from "../data/site";
---
<header class="site-header">
  <div class="container">
    <div class="site-header__row">
      <a class="logo" href="#hero" aria-label="Омега-Київ — на початок сторінки"><Logo /><span>Омега<b>·</b>Київ</span></a>
      <nav class="nav" id="nav" aria-label="Основна навігація">
        <ul>
          <li><a href="#route">Напрями</a></li>
          <li><a href="#doctors">Лікарі</a></li>
          <li><a href="#branches">Адреси</a></li>
        </ul>
      </nav>
      <a class="header-tel" href={phones[0].href}>{phones[0].label}</a>
      <a class="icon-btn" href={phones[0].href} aria-label="Зателефонувати: 044 333 4 333" data-rec="W-R005">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
      </a>
      <a class="btn btn--gold btn--sm header-cta" href="#booking">Записатися</a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Меню" data-menu>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
