---
// A future page that is not built in the demo yet. Inactive element, no href; click opens the «Розділ у розробці» dialog (src/scripts/ui.ts).
interface Props { note: string; class?: string; }
const { note, class: cls } = Astro.props;
---
<span class:list={["future-link", cls]} role="link" aria-disabled="true" tabindex="0" data-future><slot /><span class="future-link__note" aria-hidden="true">{note}</span><span class="visually-hidden"> ({note})</span></span>
